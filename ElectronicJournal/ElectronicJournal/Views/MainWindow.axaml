<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElectronicJournal.ViewModels"
        xmlns:models="using:ElectronicJournal.Models"
        x:Class="ElectronicJournal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Электронный журнал"
        Width="520" Height="520"
        WindowStartupLocation="CenterScreen">
        
  <Window.Styles>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#8B2E2E" />
      <Setter Property="Foreground" Value="#FFE8E8" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0"
               Text="Классы"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0"
               Text="{Binding NewClassName, Mode=TwoWay}"
               Margin="0,0,8,0" />
      <Button Grid.Column="1"
              Content="Добавить"
              Command="{Binding AddClassCommand}" />
    </Grid>

    <ListBox Grid.Row="2"
             ItemsSource="{Binding Classes}"
             SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:SchoolClass">
          <TextBlock Text="{Binding Name}" FontSize="16" Margin="4" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="3"
            Content="Удалить выбранный класс"
            Command="{Binding DeleteClassCommand}"
            Classes="danger"
            HorizontalAlignment="Left"
            Margin="0,8,0,0" />
  </Grid>
</Window>